<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://damirbuilds.com{% if post %}/blog/{{ post.slug }}/{% else %}/blog/{% endif %}">
<link rel="icon" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="robots" content="{% if post.noindex %}noindex, follow{% else %}index, follow{% endif %}">
<meta property="og:type" content="{% if post %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="https://damirbuilds.com{% if post %}/blog/{{ post.slug }}/{% else %}/blog/{% endif %}">
<meta property="og:site_name" content="damirbuilds">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
{% if post.socialImageUrl %}
<meta property="og:image" content="{{ post.socialImageUrl }}">
<meta name="twitter:image" content="{{ post.socialImageUrl }}">
{% endif %}
{% if post %}
<meta property="article:published_time" content="{{ post.publishedAt }}">
<meta property="article:modified_time" content="{{ post.updatedAt or post.publishedAt }}">
<meta property="article:author" content="Damir">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ post.publishedAt }}",
  "dateModified": "{{ post.updatedAt or post.publishedAt }}",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://damirbuilds.com/blog/{{ post.slug }}/" },
  "url": "https://damirbuilds.com/blog/{{ post.slug }}/",
  {% if post.imageUrl %}"image": {{ post.imageUrl | dump | safe }},{% endif %}
  {% if post.wordCount %}"wordCount": {{ post.wordCount }},{% endif %}
  "author": { "@type": "Person", "name": "Damir", "url": "https://damirbuilds.com" },
  "publisher": {
    "@type": "Organization",
    "name": "damirbuilds",
    "url": "https://damirbuilds.com",
    "logo": { "@type": "ImageObject", "url": "https://damirbuilds.com/logo.png" },
    "sameAs": ["https://x.com/damirbuilds"]
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://damirbuilds.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://damirbuilds.com/blog/" },
    { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "https://damirbuilds.com/blog/{{ post.slug }}/" }
  ]
}
</script>
{% else %}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "WebSite", "name": "damirbuilds", "url": "https://damirbuilds.com/" }
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "damirbuilds",
  "url": "https://damirbuilds.com/",
  "logo": "https://damirbuilds.com/logo.png",
  "sameAs": ["https://x.com/damirbuilds"]
}
</script>
{% endif %}
{% if post.faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in post.faqs %}
    {
      "@type": "Question",
      "name": {{ faq.question | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ faq.answer | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/shared.css">
<style>
  /* shared.css (loaded above) supplies :root tokens, reset, typography,
     nav/dropdown, buttons, footer, and the custom cursor — everything
     below is blog-page-specific only. */

  .wrap-narrow{ max-width:720px; margin:0 auto; padding:0 32px; }
  @media (max-width:640px){ .wrap-narrow{ padding:0 20px; } }

  /* ---------- BLOG LIST PAGE ---------- */
  .blog-hero{
    position:relative;
    padding:76px 0 48px;
    border-bottom:1px solid var(--line);
    overflow:hidden;
  }
  .blog-hero::before{
    content:"";
    position:absolute;
    top:-120px; right:-100px;
    width:420px; height:420px;
    background:radial-gradient(circle, rgba(255,90,54,0.14), transparent 70%);
    pointer-events:none;
  }
  .blog-headline{ position:relative; font-size:clamp(28px, 4.8vw, 48px); margin-top:14px; max-width:16ch; }
  .blog-sub{ position:relative; color:var(--muted); font-size:17px; max-width:56ch; margin-top:18px; }

  .blog-list{ padding:60px 0 88px; }
  .post-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:28px; }
  @media (max-width:480px){ .post-grid{ grid-template-columns:1fr; gap:20px; } }
  .post-card{
    display:flex;
    flex-direction:column;
    height:100%;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:14px;
    overflow:hidden;
    transition:border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .post-card:hover, .post-card:focus-visible{
    border-color:var(--hot);
    transform:translateY(-4px);
    box-shadow:0 16px 32px rgba(0,0,0,0.35), 0 0 0 1px rgba(255,90,54,0.15);
    outline:none;
  }
  .post-card-img{
    width:100%;
    aspect-ratio:16/9;
    height:auto;
    object-fit:cover;
    display:block;
    background:linear-gradient(135deg, var(--panel-2), var(--panel));
    transition:transform .3s ease;
  }
  .post-card:hover .post-card-img{ transform:scale(1.03); }
  .post-card-body{ display:flex; flex-direction:column; flex:1; padding:24px 24px 26px; }
  .post-card-date{ font-size:12.5px; font-weight:600; letter-spacing:0.05em; text-transform:uppercase; color:var(--hot); margin-bottom:12px; }
  .post-card-body h3{ font-size:19px; margin-bottom:10px; line-height:1.3; }
  .post-card-body p{
    color:var(--muted);
    font-size:14.5px;
    line-height:1.6;
    flex:1;
    display:-webkit-box;
    -webkit-line-clamp:3;
    -webkit-box-orient:vertical;
    overflow:hidden;
  }
  .post-card-arrow{
    margin-top:16px;
    font-size:13.5px;
    font-weight:600;
    color:var(--text);
    display:inline-flex;
    align-items:center;
    gap:6px;
  }
  .post-card-arrow span{ transition:transform .2s ease; }
  .post-card:hover .post-card-arrow span{ transform:translateX(3px); }
  .blog-state{ color:var(--muted); font-size:16px; padding:60px 0; text-align:center; border:1px dashed var(--line); border-radius:12px; }

  /* ---------- SINGLE POST PAGE ---------- */
  header.post-hero{ padding:56px 0 0; }
  .post-back{ display:inline-block; margin-bottom:24px; }
  h1.post-title{ font-size:clamp(26px, 4.6vw, 46px); margin-top:12px; }
  .post-cover{ width:100%; max-height:460px; object-fit:cover; border-radius:12px; border:1px solid var(--line); margin-top:36px; display:block; }

  .post-body{ padding:44px 0 24px; font-size:17.5px; color:var(--text); }
  .post-body p{ margin-bottom:22px; color:#D7DBE0; }
  .post-body > p:first-of-type::first-letter{
    font-family:'Space Grotesk', sans-serif;
    font-size:52px;
    font-weight:700;
    color:var(--hot);
    float:left;
    line-height:0.85;
    margin:8px 10px 0 0;
  }
  .post-body h2{ font-size:25px; margin:44px 0 18px; word-wrap:break-word; }
  .post-body h3{ font-size:20px; margin:34px 0 14px; word-wrap:break-word; }
  .post-body blockquote{
    border-left:2px solid var(--hot);
    background:var(--panel);
    border-radius:0 8px 8px 0;
    padding:16px 20px;
    margin:28px 0;
    color:var(--muted);
    font-style:italic;
  }
  .post-body ul, .post-body ol{ margin:0 0 22px 22px; color:#D7DBE0; }
  .post-body li{ margin-bottom:9px; }
  .post-body a{ color:var(--hot); border-bottom:1px solid rgba(255,90,54,0.4); transition:border-color .15s ease; overflow-wrap:break-word; }
  .post-body a:hover{ border-color:var(--hot); }
  .post-body img{ width:100%; height:auto; border-radius:12px; border:1px solid var(--line); margin:32px 0; display:block; }
  .post-body pre{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:18px 20px;
    overflow-x:auto;
    margin:28px 0;
    font-size:14px;
    max-width:100%;
  }
  .post-body code{
    font-family:'SFMono-Regular', Consolas, monospace;
    background:var(--panel);
    padding:2px 6px;
    border-radius:4px;
    font-size:0.9em;
    word-break:break-word;
  }
  .post-body pre code{ background:none; padding:0; word-break:normal; }
  .post-body hr{ border:none; border-top:1px solid var(--line); margin:40px 0; }
  @media (max-width:640px){
    .post-body{ font-size:16.5px; }
    .post-body > p:first-of-type::first-letter{ font-size:42px; margin:6px 8px 0 0; }
  }

  .faq-section{ padding:16px 0 40px; border-top:1px solid var(--line); margin-top:24px; }
  .faq-section h2{ font-size:24px; margin:32px 0 20px; }
  .faq-item{ padding:18px 0; border-bottom:1px solid var(--line); }
  .faq-item h3{ font-size:17px; margin-bottom:8px; }
  .faq-item p{ color:var(--muted); font-size:15px; }

  .post-cta{ border:1px solid var(--line); background:var(--panel); border-radius:12px; padding:32px; margin:48px 0 64px; }
  .post-cta h3{ font-size:22px; margin-bottom:10px; }
  .post-cta p{ color:var(--muted); font-size:15px; max-width:48ch; margin-bottom:22px; }
  @media (max-width:480px){
    .post-cta{ padding:24px; }
  }

  /* shared.css's `nav{}` rule (sticky top bar) targets any <nav> element,
     including the prev/next <nav class="post-nav"> below — reset it back
     to a plain block before applying the card layout. */
  nav.post-nav{ position:static; top:auto; z-index:auto; padding:0; border-bottom:none; background:none; backdrop-filter:none; -webkit-backdrop-filter:none; }
  .post-nav{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin:0 0 56px; }
  @media (max-width:600px){ .post-nav{ grid-template-columns:1fr; } }
  .post-nav-item{ border:1px solid var(--line); border-radius:12px; padding:18px 20px; transition:border-color .15s ease, background .15s ease; }
  .post-nav-item:hover, .post-nav-item:focus-visible{ border-color:var(--hot); background:var(--panel); outline:none; }
  .post-nav-item.next{ text-align:right; }
  .post-nav-label{ font-size:12.5px; color:var(--muted-2); margin-bottom:6px; }
  .post-nav-title{ font-size:15px; font-weight:600; color:var(--text); }
</style>
</head>
<body>

<site-nav></site-nav>

{% if post %}
<header class="post-hero">
  <div class="wrap-narrow">
    <a class="link-quiet post-back" href="/blog/">← Back to blog</a>
    <span class="eyebrow">{{ post.publishedAt | readableDate }}</span>
    <h1 class="post-title">{{ title }}</h1>
    {% if post.imageUrl %}
    <img class="post-cover" src="{{ post.imageUrl }}" alt="{{ post.mainImageAlt or title }}">
    {% endif %}
  </div>
</header>

<div class="wrap-narrow">
  <div class="post-body">{{ content | safe }}</div>

  {% if post.faqs %}
  <section class="faq-section">
    <h2>Frequently Asked Questions</h2>
    {% for faq in post.faqs %}
    <div class="faq-item">
      <h3>{{ faq.question }}</h3>
      <p>{{ faq.answer }}</p>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <div class="post-cta">
    <h3>Want to work together?</h3>
    <p>Get in touch and tell me what you're working on.</p>
    <a class="btn-primary" href="/contact.html">Get in touch →</a>
  </div>
</div>
{% else %}
<div class="wrap">{{ content | safe }}</div>
{% endif %}

<site-footer></site-footer>

<script src="/site-nav.js" defer></script>
</body>
</html>
