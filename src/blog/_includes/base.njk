<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<script>(function(){try{var t=localStorage.getItem('theme');if(!t){t='dark';}document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://damirbuilds.com{% if post %}/blog/{{ post.slug }}/{% else %}/blog/{% endif %}">
<link rel="icon" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="robots" content="{% if post.noindex %}noindex, follow{% else %}index, follow{% endif %}">
<meta property="og:type" content="{% if post %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="https://damirbuilds.com{% if post %}/blog/{{ post.slug }}/{% else %}/blog/{% endif %}">
<meta property="og:site_name" content="damirbuilds">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
{% if post.socialImageUrl %}
<meta property="og:image" content="{{ post.socialImageUrl }}">
<meta name="twitter:image" content="{{ post.socialImageUrl }}">
{% endif %}
{% if post %}
<meta property="article:published_time" content="{{ post.publishedAt }}">
<meta property="article:modified_time" content="{{ post.updatedAt or post.publishedAt }}">
<meta property="article:author" content="Damir">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ post.title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ post.publishedAt }}",
  "dateModified": "{{ post.updatedAt or post.publishedAt }}",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://damirbuilds.com/blog/{{ post.slug }}/" },
  "url": "https://damirbuilds.com/blog/{{ post.slug }}/",
  {% if post.imageUrl %}"image": {{ post.imageUrl | dump | safe }},{% endif %}
  {% if post.wordCount %}"wordCount": {{ post.wordCount }},{% endif %}
  "author": { "@type": "Person", "name": "Damir", "url": "https://damirbuilds.com", "jobTitle": "AI Growth Systems Specialist", "image": "https://damirbuilds.com/damir-avatar.webp" },
  "publisher": {
    "@type": "Organization",
    "name": "damirbuilds",
    "url": "https://damirbuilds.com",
    "logo": { "@type": "ImageObject", "url": "https://damirbuilds.com/logo.png" },
    "sameAs": ["https://x.com/damirbuilds"]
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://damirbuilds.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://damirbuilds.com/blog/" },
    { "@type": "ListItem", "position": 3, "name": {{ post.title | dump | safe }}, "item": "https://damirbuilds.com/blog/{{ post.slug }}/" }
  ]
}
</script>
{% else %}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "WebSite", "name": "damirbuilds", "url": "https://damirbuilds.com/" }
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "damirbuilds",
  "url": "https://damirbuilds.com/",
  "logo": "https://damirbuilds.com/logo.png",
  "sameAs": ["https://x.com/damirbuilds"]
}
</script>
{% endif %}
{% if post.faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in post.faqs %}
    {
      "@type": "Question",
      "name": {{ faq.question | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ faq.answer | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/shared.css">
<style>
  /* shared.css (loaded above) supplies :root tokens, reset, typography,
     nav/dropdown, buttons, footer, and the custom cursor — everything
     below is blog-page-specific only. */

  .wrap-narrow{ max-width:720px; margin:0 auto; padding:0 32px; }
  .wrap-hero{ max-width:900px; margin:0 auto; padding:0 32px; }
  @media (max-width:640px){ .wrap-narrow{ padding:0 20px; } .wrap-hero{ padding:0 20px; } }

  /* ---------- BLOG LIST PAGE ---------- */
  .blog-hero{
    position:relative;
    padding:76px 0 48px;
    border-bottom:1px solid var(--line);
  }
  /* No overflow:hidden here on purpose — that was the actual bug.
     A blurred circle has no hard edge of its own, but overflow:hidden
     on the parent still clips the paint at the container's own box,
     which cut the blur off mid-fade and produced a hard ring. The
     homepage/service-page rocket glow avoids this the same way: no
     clipping ancestor, so the blur is free to feather to nothing.
     Horizontal bleed is caught safely by `overflow-x:clip` on <html>
     in shared.css instead, which doesn't clip this element's own
     paint, only stops the page from ever getting a horizontal
     scrollbar. */
  .blog-hero::before{
    content:"";
    position:absolute;
    top:-30%; right:-10%;
    width:340px; height:340px;
    background:rgba(var(--hot-rgb), var(--glow-alpha));
    border-radius:50%;
    filter:blur(70px);
    pointer-events:none;
  }
  .blog-headline{ position:relative; font-size:clamp(28px, 4.8vw, 48px); margin-top:14px; max-width:16ch; }
  .blog-sub{ position:relative; color:var(--muted); font-size:17px; max-width:56ch; margin-top:18px; }

  .blog-list{ padding:60px 0 88px; }
  .post-grid{ display:grid; grid-template-columns:repeat(2, 1fr); gap:32px; }
  @media (max-width:780px){ .post-grid{ grid-template-columns:1fr; gap:24px; max-width:560px; margin:0 auto; } }
  .post-card{
    display:flex;
    flex-direction:column;
    height:100%;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:14px;
    overflow:hidden;
    transition:border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .post-card:hover, .post-card:focus-visible{
    border-color:var(--hot);
    transform:translateY(-4px);
    box-shadow:0 16px 32px var(--shadow-1), 0 0 0 1px rgba(var(--hot-rgb),0.15);
    outline:none;
  }
  .post-card-img{
    width:100%;
    aspect-ratio:16/9;
    height:auto;
    object-fit:cover;
    display:block;
    background:linear-gradient(135deg, var(--panel-2), var(--panel));
    transition:transform .3s ease;
  }
  .post-card:hover .post-card-img{ transform:scale(1.03); }
  .post-card-body{ display:flex; flex-direction:column; flex:1; padding:24px 24px 26px; }
  .post-card-date{ font-size:12.5px; font-weight:600; letter-spacing:0.05em; text-transform:uppercase; color:var(--hot); margin-bottom:12px; }
  .post-card-body h3{ font-size:19px; margin-bottom:10px; line-height:1.3; }
  .post-card-body p{
    color:var(--muted);
    font-size:14.5px;
    line-height:1.6;
    flex:1;
    display:-webkit-box;
    -webkit-line-clamp:3;
    -webkit-box-orient:vertical;
    overflow:hidden;
  }
  .post-card-arrow{
    margin-top:16px;
    font-size:13.5px;
    font-weight:600;
    color:var(--text);
    display:inline-flex;
    align-items:center;
    gap:6px;
  }
  .post-card-arrow span{ transition:transform .2s ease; }
  .post-card:hover .post-card-arrow span{ transform:translateX(3px); }
  .blog-state{ color:var(--muted); font-size:16px; padding:60px 0; text-align:center; border:1px dashed var(--line); border-radius:12px; }

  /* ---------- SINGLE POST PAGE ---------- */
  header.post-hero{ padding:44px 0 0; }
  .post-breadcrumb{ display:flex; flex-wrap:wrap; align-items:center; gap:6px; font-size:13.5px; color:var(--muted-2); margin-bottom:22px; }
  .post-breadcrumb a{ color:var(--muted-2); transition:color .15s ease; }
  .post-breadcrumb a:hover{ color:var(--hot); }
  .post-breadcrumb .sep{ color:var(--muted-2); opacity:0.6; }
  .post-breadcrumb .current{ color:var(--muted); max-width:38ch; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

  h1.post-title{ font-size:clamp(26px, 4.6vw, 46px); margin-top:12px; }
  .post-meta{ display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-top:16px; font-size:13.5px; color:var(--muted); }
  .post-meta .dot{ opacity:0.5; }
  .post-cover{ width:100%; max-height:480px; object-fit:cover; border-radius:14px; border:1px solid var(--line); margin-top:32px; display:block; box-shadow:0 24px 48px var(--shadow-1); }

  /* Table of contents — a native <details>/<summary> disclosure so it
     can be collapsed/expanded by click with no JS required. The
     "post-toc" class lives on the <details> itself; the reset for
     shared.css's sticky `nav{}` rule targets the wrapping <nav> via
     .post-toc-nav below instead. */
  .post-toc{ border:1px solid var(--line); background:var(--panel); border-radius:12px; margin:40px 0 8px; overflow:hidden; }
  .post-toc summary{
    list-style:none;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:16px 22px;
    -webkit-tap-highlight-color:transparent;
  }
  .post-toc summary::-webkit-details-marker{ display:none; }
  .post-toc-title{ font-size:12.5px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; color:var(--muted-2); transition:color .15s ease; }
  .post-toc summary:hover .post-toc-title{ color:var(--text); }
  .post-toc-chevron{ color:var(--muted-2); flex-shrink:0; transition:transform .2s ease; }
  .post-toc[open] .post-toc-chevron{ transform:rotate(180deg); }
  .post-toc ol{ list-style:none; margin:0; padding:0 22px 20px; display:flex; flex-direction:column; gap:9px; }
  .post-toc li.toc-h3{ margin-left:18px; }
  .post-toc a{ font-size:14.5px; color:var(--body-text); line-height:1.4; transition:color .15s ease; }
  .post-toc a:hover{ color:var(--hot); }

  .post-body{ padding:44px 0 24px; font-size:17.5px; color:var(--text); }
  .post-body p{ margin-bottom:22px; color:var(--body-text); }
  .post-body > p:first-of-type::first-letter{
    font-family:'Space Grotesk', sans-serif;
    font-size:52px;
    font-weight:700;
    color:var(--hot);
    float:left;
    line-height:0.85;
    margin:8px 10px 0 0;
  }
  .post-body h2{ font-size:25px; margin:44px 0 18px; word-wrap:break-word; }
  .post-body h3{ font-size:20px; margin:34px 0 14px; word-wrap:break-word; }
  .post-body blockquote{
    border-left:2px solid var(--hot);
    background:var(--panel);
    border-radius:0 8px 8px 0;
    padding:16px 20px;
    margin:28px 0;
    color:var(--muted);
    font-style:italic;
  }
  .post-body ul, .post-body ol{ margin:0 0 22px 22px; color:var(--body-text); }
  .post-body li{ margin-bottom:9px; }
  .post-body a{ color:var(--hot); border-bottom:1px solid rgba(var(--hot-rgb),0.4); transition:border-color .15s ease; overflow-wrap:break-word; }
  .post-body a:hover{ border-color:var(--hot); }
  .post-body img{ width:100%; height:auto; border-radius:8px; border:1px solid var(--line); margin:32px 0; display:block; }
  .post-body pre{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:18px 20px;
    overflow-x:auto;
    margin:28px 0;
    font-size:14px;
    max-width:100%;
  }
  .post-body code{
    font-family:'SFMono-Regular', Consolas, monospace;
    background:var(--panel);
    padding:2px 6px;
    border-radius:4px;
    font-size:0.9em;
    word-break:break-word;
  }
  .post-body pre code{ background:none; padding:0; word-break:normal; }
  .post-body hr{ border:none; border-top:1px solid var(--line); margin:40px 0; }
  @media (max-width:640px){
    .post-body{ font-size:16.5px; }
    .post-body > p:first-of-type::first-letter{ font-size:42px; margin:6px 8px 0 0; }
  }

  .faq-section{ padding:16px 0 40px; border-top:1px solid var(--line); margin-top:24px; }
  .faq-section h2{ font-size:24px; margin:32px 0 20px; }
  .faq-item{ border-bottom:1px solid var(--line); }
  .faq-item h3{ margin:0; font-weight:inherit; }
  .faq-q{
    width:100%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    padding:18px 0;
    background:none;
    border:none;
    text-align:left;
    font-family:'Space Grotesk', sans-serif;
    font-size:17px;
    font-weight:600;
    color:var(--text);
    cursor:pointer;
  }
  .faq-icon{ flex-shrink:0; font-size:22px; font-weight:400; line-height:1; color:var(--muted-2); transition:transform .2s ease, color .2s ease; }
  .faq-item.open .faq-icon{ transform:rotate(45deg); color:var(--hot); }
  .faq-a{ max-height:0; overflow:hidden; transition:max-height .25s ease; }
  .faq-a p{ color:var(--muted); font-size:15px; padding-bottom:18px; }

  .post-author{
    display:flex;
    align-items:center;
    gap:18px;
    margin-top:48px;
    padding-top:32px;
    border-top:1px solid var(--line);
  }
  .post-author-photo{ width:56px; height:56px; border-radius:50%; border:1px solid var(--line); object-fit:cover; flex-shrink:0; }
  .post-author-name{ font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:15.5px; color:var(--text); }
  .post-author-title{ font-size:13px; color:var(--muted); margin-top:2px; }
  .post-author-note{ font-size:12.5px; color:var(--muted-2); margin-top:6px; }
  @media (max-width:480px){ .post-author{ gap:14px; } }

  .post-cta{
    position:relative;
    overflow:hidden;
    border:1px solid var(--line);
    background:var(--panel);
    border-radius:16px;
    padding:40px;
    margin:48px 0 64px;
  }
  .post-cta::before{
    content:"";
    position:absolute;
    top:-30px; right:-30px;
    width:220px; height:220px;
    background:rgba(var(--hot-rgb), var(--glow-alpha));
    border-radius:50%;
    filter:blur(56px);
    pointer-events:none;
  }
  .post-cta-eyebrow{ position:relative; display:block; font-size:12.5px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; color:var(--muted-2); margin-bottom:10px; }
  .post-cta h3{ position:relative; font-size:24px; margin-bottom:10px; }
  .post-cta p{ position:relative; color:var(--muted); font-size:15px; max-width:48ch; margin-bottom:24px; }
  .post-cta .btn-primary{ position:relative; }
  @media (max-width:480px){
    .post-cta{ padding:26px; }
  }

  /* shared.css's `nav{}` rule (sticky top bar) targets any <nav> element —
     including the breadcrumb, the TOC, and the prev/next block below — so
     reset its structural (sticky-bar) properties here. Each element's own
     class rule above/below (higher specificity than bare `nav{}`) still
     supplies its own padding/background/border. */
  nav.post-nav, nav.post-breadcrumb, nav.post-toc-nav{ position:static; top:auto; z-index:auto; border-bottom:none; backdrop-filter:none; -webkit-backdrop-filter:none; }
  nav.post-nav{ padding:0; background:none; }
  nav.post-breadcrumb{ padding:0; background:none; }
  .post-nav{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin:0 0 56px; }
  @media (max-width:600px){ .post-nav{ grid-template-columns:1fr; } }
  .post-nav-item{ border:1px solid var(--line); border-radius:12px; padding:18px 20px; transition:border-color .15s ease, background .15s ease; }
  .post-nav-item:hover, .post-nav-item:focus-visible{ border-color:var(--hot); background:var(--panel); outline:none; }
  .post-nav-item.next{ text-align:right; }
  .post-nav-label{ font-size:12.5px; color:var(--muted-2); margin-bottom:6px; }
  .post-nav-title{ font-size:15px; font-weight:600; color:var(--text); }
</style>
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<site-nav></site-nav>

<main id="main">

{% if post %}
<header class="post-hero">
  <div class="wrap-hero">
    <nav class="post-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/blog/">Blog</a>
      <span class="sep">/</span>
      <span class="current">{{ post.title }}</span>
    </nav>
    <h1 class="post-title">{{ post.title }}</h1>
    <div class="post-meta">
      <span>{{ post.publishedAt | readableDate }}</span>
      {% if post.readingTime %}<span class="dot">·</span><span>{{ post.readingTime }} min read</span>{% endif %}
    </div>
    {% if post.imageUrl %}
    <img class="post-cover" src="{{ post.imageUrl }}" alt="{{ post.mainImageAlt or post.title }}" width="1200" height="675" decoding="async">
    {% endif %}
  </div>
</header>

<div class="wrap-narrow">
  {% if post.headings.length > 1 %}
  <nav class="post-toc-nav" aria-label="Table of contents">
    <details class="post-toc" open>
      <summary>
        <span class="post-toc-title">On this page</span>
        <svg class="post-toc-chevron" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 7.5l5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </summary>
      <ol>
        {% for h in post.headings %}
        <li class="{% if h.level == 3 %}toc-h3{% endif %}"><a href="#{{ h.slug }}">{{ h.text }}</a></li>
        {% endfor %}
      </ol>
    </details>
  </nav>
  {% endif %}

  <div class="post-body">{{ content | safe }}</div>

  {% if post.faqs %}
  <section class="faq-section">
    <h2>Frequently Asked Questions</h2>
    {% for faq in post.faqs %}
    <div class="faq-item">
      <h3>
        <button class="faq-q" aria-expanded="false" aria-controls="faq-a-{{ loop.index }}" id="faq-q-{{ loop.index }}">
          <span>{{ faq.question }}</span>
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
      </h3>
      <div class="faq-a" id="faq-a-{{ loop.index }}" role="region" aria-labelledby="faq-q-{{ loop.index }}">
        <p>{{ faq.answer }}</p>
      </div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <div class="post-author">
    <img class="post-author-photo" src="/damir-avatar.webp" width="56" height="56" alt="Portrait of Damir" loading="lazy" decoding="async">
    <div>
      <div class="post-author-name">Damir</div>
      <div class="post-author-title">AI Growth Systems Specialist</div>
      <div class="post-author-note">Builds and writes everything on this site personally, not an agency.</div>
    </div>
  </div>

  <div class="post-cta">
    <span class="post-cta-eyebrow">Let's build</span>
    <h3>Stop losing leads to slow follow-up.</h3>
    <p>I'll build the exact automation your business needs, speed-to-lead, routing, or reactivation, and get it running in days, not months.</p>
    <a class="btn-primary" href="/contact.html">Get an automation built →</a>
  </div>
</div>
{% else %}
<div class="wrap">{{ content | safe }}</div>
{% endif %}

</main>

<site-footer></site-footer>

<script>
  document.querySelectorAll('.faq-item').forEach(function(item){
    var q = item.querySelector('.faq-q');
    var a = item.querySelector('.faq-a');
    if(!q || !a) return;
    q.addEventListener('click', function(){
      var isOpen = item.classList.contains('open');
      if(isOpen){
        item.classList.remove('open');
        a.style.maxHeight = null;
        q.setAttribute('aria-expanded', 'false');
      }else{
        item.classList.add('open');
        a.style.maxHeight = a.scrollHeight + 'px';
        q.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
<script src="/site-nav.js" defer></script>
</body>
</html>
